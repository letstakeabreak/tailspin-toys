---
import type { Category, Publisher } from '../types/game';

interface Props {
    categories: Category[];
    publishers: Publisher[];
}

const { categories, publishers } = Astro.props;
---

<form
    class="mb-8 bg-slate-800/60 rounded-xl border border-slate-700/50 p-6 space-y-6"
    aria-label="Filter games"
    data-testid="game-filters"
    data-game-filters
>
    <fieldset>
        <legend class="text-sm font-medium text-slate-100 mb-3">Categories</legend>
        <div class="flex flex-wrap gap-3">
            {categories.map((category) => (
                <label class="inline-flex items-center gap-2 rounded-lg border border-slate-600 bg-slate-700/50 px-3 py-2 text-sm text-slate-200 cursor-pointer hover:border-blue-500/50 has-[:checked]:border-blue-500 has-[:checked]:bg-blue-600/20 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-blue-500">
                    <input
                        type="checkbox"
                        name="category"
                        value={category.id}
                        class="h-4 w-4 rounded border-slate-500 bg-slate-800 accent-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                        data-testid={`filter-category-${category.id}`}
                    />
                    {category.name}
                </label>
            ))}
        </div>
    </fieldset>

    <div class="flex flex-wrap items-end gap-4">
        <div>
            <label for="filter-publisher" class="block text-sm font-medium text-slate-100 mb-2">Publisher</label>
            <select
                id="filter-publisher"
                name="publisher"
                class="rounded-lg border border-slate-600 bg-slate-700 px-3 py-2 text-sm text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                data-testid="filter-publisher"
            >
                <option value="">All publishers</option>
                {publishers.map((publisher) => (
                    <option value={publisher.id}>{publisher.name}</option>
                ))}
            </select>
        </div>

        <button
            type="reset"
            class="rounded-lg border border-slate-600 bg-slate-700 px-4 py-2 text-sm font-medium text-slate-100 hover:bg-slate-600 focus:ring-2 focus:ring-blue-500 focus:outline-none transition-colors"
            data-testid="filter-reset"
        >
            Clear filters
        </button>

        <p class="text-sm text-slate-300" role="status" aria-live="polite" data-testid="filter-count"></p>
    </div>
</form>

<script>
    const form = document.querySelector<HTMLFormElement>('[data-game-filters]');
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
    const emptyState = document.querySelector<HTMLElement>('[data-testid="filter-empty"]');
    const count = form?.querySelector<HTMLElement>('[data-testid="filter-count"]');
    const checkboxes = Array.from(
        form?.querySelectorAll<HTMLInputElement>('input[name="category"]') ?? [],
    );
    const select = form?.querySelector<HTMLSelectElement>('select[name="publisher"]');

    /** Shows only cards matching the selected filters and syncs the URL and result count. */
    function applyFilters(): void {
        const categoryIds = checkboxes.filter((box) => box.checked).map((box) => box.value);
        const publisherId = select?.value ?? '';
        let visible = 0;

        for (const card of cards) {
            const matchesCategory =
                categoryIds.length === 0 || categoryIds.includes(card.dataset.categoryId ?? '');
            const matchesPublisher = publisherId === '' || card.dataset.publisherId === publisherId;
            card.hidden = !(matchesCategory && matchesPublisher);
            if (!card.hidden) visible++;
        }

        if (emptyState) emptyState.hidden = visible !== 0;
        if (count) count.textContent = `Showing ${visible} of ${cards.length} games`;

        const params = new URLSearchParams();
        categoryIds.forEach((id) => params.append('category', id));
        if (publisherId) params.set('publisher', publisherId);
        const query = params.toString();
        history.replaceState(null, '', query ? `?${query}` : location.pathname);
    }

    /** Restores the checkbox and select state from the URL query string. Unknown ids are ignored. */
    function restoreFromUrl(): void {
        const params = new URLSearchParams(location.search);
        const selected = params.getAll('category');
        checkboxes.forEach((box) => {
            box.checked = selected.includes(box.value);
        });
        if (select) {
            const publisher = params.get('publisher') ?? '';
            select.value = Array.from(select.options).some((o) => o.value === publisher) ? publisher : '';
        }
    }

    if (form) {
        form.addEventListener('change', applyFilters);
        form.addEventListener('reset', () => setTimeout(applyFilters));
        form.addEventListener('submit', (event) => event.preventDefault());
        restoreFromUrl();
        applyFilters();
    }
</script>
